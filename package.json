{
  "name": "speak-louder-sphere",
  "version": "0.1.0",
  "description": "A glowing sphere that reacts to your voice and shows live captions. Drop-in Web Component (WebGL + Web Audio + Web Speech API).",
  "license": "MIT",
  "author": {
    "name": "Likemiens",
    "url": "https://github.com/Likemiens"
  },
  "homepage": "https://speak-louder-sphere.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Likemiens/SpeakLouderSphere.git"
  },
  "bugs": {
    "url": "https://github.com/Likemiens/SpeakLouderSphere/issues"
  },
  "type": "module",
  "private": true,
  "main": "./dist/speak-louder-sphere.js",
  "module": "./dist/speak-louder-sphere.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/speak-louder-sphere.js"
    },
    "./iife": "./dist/speak-louder-sphere.iife.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "web-component",
    "custom-element",
    "webgl",
    "voice",
    "speech-recognition",
    "live-captions",
    "audio-visualizer",
    "orb",
    "siri",
    "ai-assistant",
    "widget"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.types.json",
    "build:site": "npm run build && vite build --config vite.site.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
